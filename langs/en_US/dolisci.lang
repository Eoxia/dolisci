#
# Module
#
ModuleDoliSciName = DoliSCI
DoliSciDescription = Tools for property companies (SCI): simplified property, fiscal lot, rental and rent receipt management
DoliSciDescriptionLong = Simplified management for property companies (SCI): real estate projects (buildings and units), purchased property products with fiscal lots, separate rental services (base rent 706100 and charges provision 708800), and "Rent receipt" PDF invoice template.

#
# Permissions
#
ReadAdminPageDoliSci = Access the module setup page

